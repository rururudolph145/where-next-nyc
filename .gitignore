# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.eggs/
dist/
build/
*.egg-info/

# Virtual environments
venv/
env/
.venv/
.env

# direnv (per-developer shell activation; do not commit)
.envrc
.direnv/

# Testing
.pytest_cache/
htmlcov/
.tox/
.coverage
coverage.xml

# IDEs
.idea/
.vscode/
*.swp

# Jupyter
.ipynb_checkpoints/

# MkDocs
site/
.cache/

# MLflow
mlruns/

# Model artifacts
models/*.pkl

# Data
data/raw/
data/**/*.parquet
data/**/*.csv
data/*.parquet
data/*.csv

# Reference / lookup files (shapefiles, etc.)
data/reference/*
!data/reference/.gitkeep

# Reference materials (JDs, PDFs, external docs — not part of the codebase)
reference/

# Implementation checklists
implementation_checklist/

# Watermarks (DAG idempotency markers — keep .gitkeep only)
data/watermarks/
!data/watermarks/refresh_15min/.gitkeep

# Orchestration
orchestration/logs/
orchestration/.env

# DVC
.dvc/tmp/

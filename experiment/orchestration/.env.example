# Copy to .env and adjust.

# Match this to your host user so mounted volumes have the right ownership.
# Find with: id -u
AIRFLOW_UID=50000

# Seconds the DAG sleeps inside the predict task to mimic real time.
# 0 = no sleep (full-speed replay). 5 = visible tick. 900 = real-time 15 min.
INFERENCE_REAL_SLEEP_SECONDS=5

# Where the uvicorn app exposing /heatmap is running, as seen from the
# Airflow containers. On Linux/Mac/Windows Docker Desktop, host.docker.internal
# resolves to the host machine.
INFERENCE_API_BASE_URL=http://host.docker.internal:8000
